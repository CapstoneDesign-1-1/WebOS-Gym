  {
    "task_id": "MULTI-NHIS-OVERSEAS-001",
    "instruction": "I traveled abroad and need to check if I qualify for the NHIS premium exemption. Please navigate to the '해외 출국자 보험료감면 여부 조회' (Overseas traveler premium exemption inquiry) menu on the website to verify the rules. Then, save my travel record and whether it is exempted into the spreadsheet starting at A1 with headers 'Departure Date (출국일)', 'Return Date (입국일)', and 'Exemption Status (면제 여부)'. For the exemption status, please answer strictly with 'Yes' or 'No'.\nDepart: 2023-05-01, Return: 2023-07-15.",
    "website": [
      {
        "id": "web",
        "url": "https://www.nhis.or.kr/nhis/minwon/initCtrbCalcView.do"
      },
      {
        "id": "sheet",
        "url": "http://localhost:3000/spreadsheet"
      }
    ],
    "evaluation": {
      "mode": "spreadsheet",
      "operator": "and",
      "rules": [
        {
          "website_id": "sheet",
          "cell": "A1",
          "value": "(?i).*Departure.*|.*출국.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "B1",
          "value": "(?i).*Return.*|.*입국.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "C1",
          "value": "(?i).*Exemption.*|.*Status.*|.*면제.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "A2",
          "value": ".*2023-05-01.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "B2",
          "value": ".*2023-07-15.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "C2",
          "value": "(?i).*Not.*|.*No.*|.*비면제.*|.*대상\\s*아님.*|.*X.*",
          "match": "regex"
        }
      ]
    }
  }
  //1. Web에서 '해외 출국자 보험료 감면 여부 조회'가 보일 때까지 스크롤 다운
  //2. Web에서 '해외 출국자 보험료 감면 여부 조회' or '계산하기' 마우스 왼쪽 클릭
  //3. Web에서 '조회정보'를 입력할 수 있는 칸이 나올 때까지 스크롤 다운
  //4. Web에서 출국일 입력 칸에 마우스 왼쪽 클릭
  //5. Web에서 '20230501' 입력
  //6. Web에서 입국일 입력 칸에 마우스 왼쪽 클릭
  //7. Web에서 '20230715' 입력
  //8. Web에서 조회 버튼 클릭
