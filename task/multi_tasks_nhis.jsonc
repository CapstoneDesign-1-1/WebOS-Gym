[
  {
    "task_id": "MULTI-NHIS-ARREARS-001",
    "instruction": "I am a local resident (내국인) and missed my health insurance (건강보험) premium payment of 150,000 won, which was originally due on March, 2024. If I plan to pay it on May 10, 2024, how much will the late fee and the total payment be? Please use the NHIS late fee calculator (연체금 계산하기) to find the 'Late Fee' and 'Total Amount'. Save the results in the spreadsheet starting at A1 with headers 'Category' and 'Amount'.",
    "website": [
      {
        "id": "web",
        "url": "https://www.nhis.or.kr/nhis/minwon/initCtrbCalcView.do"
      },
      {
        "id": "sheet",
        "url": "http://localhost:3000/spreadsheet"
      }
    ],
    "evaluation": {
      "mode": "spreadsheet",
      "operator": "and",
      "rules": [
        {
          "website_id": "sheet",
          "cell": "A1",
          "value": "(?i).*Category.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "B1",
          "value": "(?i).*Amount.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "A2",
          "value": "(?i).*Late\\s*Fee.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "B2",
          "value": ".*2,900.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "A3",
          "value": "(?i).*Total\\s*Amount.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "B3",
          "value": ".152,900.*",
          "match": "regex"
        }
      ]
    }
  },
  //1. Web에서 연체금 계산하기 버튼이 나올때까지 스크롤 다운
  //2. Web에서 '연체금 계산하기' or '계산하기' 왼쪽 클릭
  //3. Web에서 연체금 모의 계산기 보일 때까지 스크롤 다운
  //4. Web에서 보험료 입력 칸에 왼쪽 클릭
  //5. Web에서 '150000' 입력
  //6. Web에서 가입자 구분 내국인 칸 왼쪽 클릭
  //7. Web에서 보험 구분 건강 칸 왼쪽 클릭
  //8. Web에서 고지년월 입력칸에 왼쪽 클릭
  //9. Web에서 '202403' 입력
  //10. Web에서 납부예정일 입력칸에 왼쪽 클릭
  //11. Web에서 '20240510' 입력
  //12. Web에서 계산하기 버튼 클릭
  //13. Web에서 스크롤 다운해 연체금 모의 계산 결과 확인
  //14. Sheet의 A1 왼쪽 클릭
  //15. Sheet에서 'Category' 입력
  //16. Sheet의 B1 왼쪽 클릭
  //17. Sheet에서 'Amount' 입력
  //18. Sheet의 A2 왼쪽 클릭
  //19. Sheet에서 'Late Fee' 입력
  //20. Sheet의 B2 왼쪽 클릭
  //21. Sheet에서 '2,900' 입력
  //22. Sheet의 A3 왼쪽 클릭
  //23. Sheet에서 'Total Amount' 입력
  //24. Sheet의 B3 왼쪽 클릭
  //25. Sheet에서 '152,900' 입력
  {
    "task_id": "MULTI-NHIS-ARREARS-ALL-001",
    "instruction": "I am a local resident (내국인) and I missed the payments for all four of my major insurances. I need to calculate the late fee and total amount for each one using the NHIS late fee calculator (연체금 계산하기). \nHere are the details for each:\n1. Health Insurance (건강보험): 150,000 won, Billing Month (고지년월): 2024-02, Expected Payment Date (납부예정일): 2024-05-10.\n2. National Pension (국민연금): 200,000 won, Billing Month: 2024-02, Expected Payment Date: 2024-05-10.\n3. Employment Insurance (고용보험): 50,000 won, Billing Month: 2024-02, Expected Payment Date: 2024-05-10.\n4. Industrial Accident Insurance (산재보험): 30,000 won, Billing Month: 2024-02, Expected Payment Date: 2024-05-10.\n\nPlease calculate them sequentially and save the results in the spreadsheet starting at A1 with headers 'Insurance Type', 'Late Fee', and 'Total Amount'.",
    "website": [
      {
        "id": "web",
        "url": "https://www.nhis.or.kr/nhis/minwon/initCtrbCalcView.do"
      },
      {
        "id": "sheet",
        "url": "http://localhost:3000/spreadsheet"
      }
    ],
    "evaluation": {
      "mode": "spreadsheet",
      "operator": "and",
      "rules": [
        {
          "website_id": "sheet",
          "cell": "A1",
          "value": "(?i).*Insurance\\s*Type.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "B1",
          "value": "(?i).*Late\\s*Fee.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "C1",
          "value": "(?i).*Total\\s*Amount.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "A2",
          "value": "(?i).*Health.*|.*건강.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "B2",
          "value": ".*2,900.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "C2",
          "value": ".*152,900.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "A3",
          "value": "(?i).*Pension.*|.*연금.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "B3",
          "value": ".*4,990.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "C3",
          "value": ".*204,990.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "A4",
          "value": "(?i).*Employment.*|.*고용.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "B4",
          "value": ".*1,250.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "C4",
          "value": ".*51,250.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "A5",
          "value": "(?i).*Industrial.*|(?i).*Accident.*|.*산재.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "B5",
          "value": ".*750.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "C5",
          "value": ".*30,750.*",
          "match": "regex"
        }
      ]
    }
  },
  //1. Sheet의 A1 왼쪽 클릭
  //2. Sheet에서 'Insurance Type' 입력
  //3. Sheet의 B1 왼쪽 클릭
