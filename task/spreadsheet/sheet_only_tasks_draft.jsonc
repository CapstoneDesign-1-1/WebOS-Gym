  {
    // Cells used: A1, B2, B1, A2 → 4 cells
    // Functions: cell reference swap (=A1, =B2)
    //
    // Visual layout of the swap:
    //     A              B
    // 1  "Apple"(input)  =A1 → "Apple"   ← A1's value appears at B1
    // 2  =B2 → "Orange"  "Orange"(input) ← B2's value appears at A2
