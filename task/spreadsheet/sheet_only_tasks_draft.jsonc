[
  // =====================================================================
  // Spreadsheet-Only Tasks (Draft)
  // URL: http://localhost:3000/spreadsheet
  // Conditions:
  //   - Single website (spreadsheet only)
  //   - No pre-injected data (agent enters all values)
  //   - Each task uses 6 cells or fewer
  //   - Evaluation uses getCellMeta states format (matches seed.jsonc schema)
  // =====================================================================

  {
    // Cells used: A1, A2, A3, A4, B1, B2 → 6 cells
    // Functions: SUM, AVERAGE
    "task_id": "sheet_only_01",
    "instruction": "Open the spreadsheet at http://localhost:3000/spreadsheet. You will record 4 days of sales figures and calculate the total and daily average.\n\n1. Enter the following sales values going down column A:\n   - A1: 100\n   - A2: 200\n   - A3: 150\n   - A4: 250\n2. In cell B1, use the SUM function to calculate the total of A1:A4.\n3. In cell B2, use the AVERAGE function to calculate the daily average of A1:A4.",
    "website": "http://localhost:3000/spreadsheet",
    "states": [
      [
        { "match": "exact", "f": "getCellMeta", "param": "A1", "property": ["cell", "v"], "value": 100 },
        { "match": "exact", "f": "getCellMeta", "param": "A2", "property": ["cell", "v"], "value": 200 },
        { "match": "exact", "f": "getCellMeta", "param": "A3", "property": ["cell", "v"], "value": 150 },
        { "match": "exact", "f": "getCellMeta", "param": "A4", "property": ["cell", "v"], "value": 250 }
      ],
      [
        { "match": "exact", "f": "getCellMeta", "param": "B1", "property": ["cell", "v"], "value": 700 },
        { "match": "exact", "f": "getCellMeta", "param": "B2", "property": ["cell", "v"], "value": 175 }
      ]
    ]
    // [Steps]
    // 1. click(x,y)      - 셀 A1 클릭
    // 2. type('100')     - 값 입력 후 hotkey(enter)
    // 3. type('200')     - A2 입력 후 hotkey(enter)
    // 4. type('150')     - A3 입력 후 hotkey(enter)
    // 5. type('250')     - A4 입력 후 hotkey(enter)
    // 6. click(x,y)      - 셀 B1 클릭
    // 7. type('=SUM(A1:A4)') - SUM 수식 입력 후 hotkey(enter)
    // 8. click(x,y)      - 셀 B2 클릭
    // 9. type('=AVERAGE(A1:A4)') - AVERAGE 수식 입력 후 hotkey(enter)
    // 10. done()
  },
  {
    // Cells used: A1, A2, A3, B1, B2, B3 → 6 cells
    // Functions: MAX, MIN, COUNT
    "task_id": "sheet_only_02",
    "instruction": "Open the spreadsheet at http://localhost:3000/spreadsheet. You will enter 3 exam scores and find the highest score, lowest score, and total count.\n\n1. Enter the following scores going down column A:\n   - A1: 88\n   - A2: 72\n   - A3: 95\n2. In cell B1, use the MAX function to find the highest score in A1:A3.\n3. In cell B2, use the MIN function to find the lowest score in A1:A3.\n4. In cell B3, use the COUNT function to count how many scores are recorded in A1:A3.",
    "website": "http://localhost:3000/spreadsheet",
    "states": [
      [
        { "match": "exact", "f": "getCellMeta", "param": "A1", "property": ["cell", "v"], "value": 88 },
        { "match": "exact", "f": "getCellMeta", "param": "A2", "property": ["cell", "v"], "value": 72 },
        { "match": "exact", "f": "getCellMeta", "param": "A3", "property": ["cell", "v"], "value": 95 }
      ],
      [
        { "match": "exact", "f": "getCellMeta", "param": "B1", "property": ["cell", "v"], "value": 95 },
        { "match": "exact", "f": "getCellMeta", "param": "B2", "property": ["cell", "v"], "value": 72 },
        { "match": "exact", "f": "getCellMeta", "param": "B3", "property": ["cell", "v"], "value": 3 }
      ]
    ]
    // [Steps]
    // 1. click(x,y)      - 셀 A1 클릭
    // 2. type('88')      - 값 입력 후 hotkey(enter)
    // 3. type('72')      - A2 입력 후 hotkey(enter)
    // 4. type('95')      - A3 입력 후 hotkey(enter)
    // 5. click(x,y)      - 셀 B1 클릭
    // 6. type('=MAX(A1:A3)') - 최댓값 수식 입력 후 hotkey(enter)
    // 7. click(x,y)      - 셀 B2 클릭
    // 8. type('=MIN(A1:A3)') - 최솟값 수식 입력 후 hotkey(enter)
    // 9. click(x,y)      - 셀 B3 클릭
    // 10. type('=COUNT(A1:A3)') - COUNT 수식 입력 후 hotkey(enter)
    // 11. done()
  },
  {
