    // Functions: IF
    "task_id": "sheet_only_03",
    "instruction": "Open the spreadsheet at http://localhost:3000/spreadsheet. You will use an IF function to determine whether a student passed or failed.\n\n1. In cell A1, enter the score: 75.\n2. In cell B1, use the IF function to display 'Pass' if the score in A1 is 70 or above, and 'Fail' otherwise.",
    "website": "http://localhost:3000/spreadsheet",
    "states": [
      [
        { "match": "exact", "f": "getCellMeta", "param": "A1", "property": ["cell", "v"], "value": 75 }
      ],
      [
        { "match": "exact", "f": "getCellMeta", "param": "B1", "property": ["cell", "v"], "value": "Pass" }
      ]
    ]
    // [Steps]
    // 1. click(x,y)      - 셀 A1 클릭
    // 2. type('75')      - 점수 입력 후 hotkey(enter)
    // 3. click(x,y)      - 셀 B1 클릭
    // 4. type('=IF(A1>=70,"Pass","Fail")') - IF 수식 입력 후 hotkey(enter)
    // 5. done()
  },
  {
    // Cells used: A1, A2, B1, B2 → 4 cells
    // Functions: CONCATENATE, LEN
    "task_id": "sheet_only_04",
    "instruction": "Open the spreadsheet at http://localhost:3000/spreadsheet. You will combine two words and measure the total character length.\n\n1. In cell A1, enter: Hello.\n2. In cell A2, enter: World.\n3. In cell B1, use the CONCATENATE function to join A1 and A2 with a space in between.\n4. In cell B2, use the LEN function to count the total number of characters in cell B1.",
    "website": "http://localhost:3000/spreadsheet",
    "states": [
      [
        { "match": "exact", "f": "getCellMeta", "param": "A1", "property": ["cell", "v"], "value": "Hello" },
        { "match": "exact", "f": "getCellMeta", "param": "A2", "property": ["cell", "v"], "value": "World" }
