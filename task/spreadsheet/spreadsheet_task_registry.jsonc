  {
    "id": "sheet_a_011_spreadsheet_phonenumber",
    "group": "A",
    "source": {
      "task_id": "spreadsheet_phonenumber",
      "path": "tasks/seed/spreadsheet/seed.jsonc",
      "instruction": "Create a phone list in Sheet1. In column A, enter the column header \"Name\" and list four names below it: Alice, Brian, Chloe, and Daniel. In column B, enter the column header \"Phone Number\" and list their phone numbers below it: (415) 555 0182, 212.555.0198, 6175550134, and 305-555-0177. Then normalize every phone number in column B into the ###-###-#### format."
    },
    "source_answer_state": [
      {
        "match": "exact",
        "param": "A1",
