  {
    "id": "sheet_b_006_multi_nhis_overseas_001",
    "group": "B",
    "source": {
      "task_id": "MULTI-NHIS-OVERSEAS-001",
      "path": "tasks/archive/tasks_verified_5_yet.jsonc",
      "instruction": "I traveled abroad and need to check if I qualify for the NHIS premium exemption. Please navigate to the '해외 출국자 보험료감면 여부 조회' (Overseas traveler premium exemption inquiry) menu on the website to verify the rules. Then, save my travel record and whether it is exempted into the spreadsheet starting at A1 with headers 'Departure Date (출국일)', 'Return Date (입국일)', and 'Exemption Status (면제 여부)'. For the exemption status, please answer strictly with 'Yes' or 'No'.\nDepart: 2023-05-01, Return: 2023-07-15."
    },
    "source_answer_state": [
      {
        "match": "regex",
        "f": "getCellMeta",
        "param": "A1",
        "property": [
          "cell",
          "v"
        ],
        "value": "(?i).*Departure.*|.*출국.*"
      },
      {
        "match": "regex",
        "f": "getCellMeta",
        "param": "A2",
        "property": [
          "cell",
          "v"
        ],
        "value": ".*2023-05-01.*"
      },
      {
        "match": "regex",
        "f": "getCellMeta",
        "param": "B1",
        "property": [
          "cell",
          "v"
        ],
        "value": "(?i).*Return.*|.*입국.*"
      },
      {
        "match": "regex",
        "f": "getCellMeta",
        "param": "B2",
        "property": [
          "cell",
          "v"
        ],
        "value": ".*2023-07-15.*"
      },
      {
        "match": "regex",
        "f": "getCellMeta",
        "param": "C1",
        "property": [
          "cell",
          "v"
        ],
        "value": "(?i).*Exemption.*|.*Status.*|.*면제.*"
      },
      {
        "match": "regex",
        "f": "getCellMeta",
        "param": "C2",
        "property": [
          "cell",
          "v"
        ],
        "value": "(?i).*Not.*|.*No.*|.*비면제.*|.*대상\\s*아님.*|.*X.*"
      }
    ],
    "seed_status": "todo",
    "seed_task": null,
    "notes": ""
  },
