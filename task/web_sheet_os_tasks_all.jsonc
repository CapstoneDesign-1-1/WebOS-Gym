    // 5. 스프레드시트 값 반영
    // 6. 최종 내용 검토
    "task_id": "web_sheet_prozilla_hipass_toll_01",
    "instruction": "Could you open the Hi-Pass 통행요금 조회 page. In 요금조회, enter 출발지 서울 and 도착지 부산. Leave 경유지 blank. If the site shows autocomplete suggestions, select the exact matching tollgate names. Copy the first route row shown in the toll results into a spreadsheet, including 경로 구분 and the fees for 1종, 2종, 3종, 4종, 5종, and 1종(경차). In the spreadsheet, convert fee text to numbers by removing commas and 원, then calculate `Light Car Difference` with `=B2-G2` where B2 is 1종 and G2 is 1종(경차). Also calculate `Highest Toll` with `=MAX(B2:F2)` and `Light Car Ratio` with `=ROUND(G2/B2,2)`. Save `~/Documents/hipass_toll_001.txt` in the format 'Scenario: 서울 to 부산 | Via: None | Route: [value] | Class 1 Toll: [value] | Class 2 Toll: [value] | Class 3 Toll: [value] | Class 4 Toll: [value] | Class 5 Toll: [value] | Light Car Toll: [value] | Light Car Difference: [value] | Highest Toll: [value] | Light Car Ratio: [value]'.",
    "website": [
      {
        "id": "web",
        "url": "https://www.hipass.co.kr/board/TollPaySearchList.do"
      },
      {
        "id": "sheet",
        "url": "http://localhost:3000/spreadsheet"
      },
      {
        "id": "os",
        "url": "http://localhost:3100/"
      }
    ],
    "evaluation": {
      "mode": "dom",
      "operator": "and",
      "rules": [
        {
          "website_id": "os",
          "selector": "textarea",
          "target": "attr",
          "attr": "value",
          "value": "Scenario: 서울 to 부산",
          "match": "contains"
        },
        {
          "website_id": "os",
          "selector": "textarea",
          "target": "attr",
          "attr": "value",
          "value": "Via: None",
          "match": "contains"
        },
        {
          "website_id": "os",
          "selector": "textarea",
          "target": "attr",
          "attr": "value",
          "value": "Route:\\s*.+",
          "match": "regex"
        },
        {
          "website_id": "os",
          "selector": "textarea",
          "target": "attr",
          "attr": "value",
          "value": "Class 1 Toll:\\s*[0-9,]+",
          "match": "regex"
        },
        {
          "website_id": "os",
          "selector": "textarea",
          "target": "attr",
          "attr": "value",
          "value": "Class 2 Toll:\\s*[0-9,]+",
          "match": "regex"
        },
        {
          "website_id": "os",
          "selector": "textarea",
          "target": "attr",
          "attr": "value",
          "value": "Class 3 Toll:\\s*[0-9,]+",
          "match": "regex"
        },
        {
          "website_id": "os",
          "selector": "textarea",
          "target": "attr",
          "attr": "value",
          "value": "Class 4 Toll:\\s*[0-9,]+",
          "match": "regex"
        },
        {
          "website_id": "os",
          "selector": "textarea",
          "target": "attr",
          "attr": "value",
          "value": "Class 5 Toll:\\s*[0-9,]+",
          "match": "regex"
        },
        {
          "website_id": "os",
          "selector": "textarea",
          "target": "attr",
          "attr": "value",
          "value": "Light Car Toll:\\s*[0-9,]+",
          "match": "regex"
        },
        {
          "website_id": "os",
          "selector": "textarea",
          "target": "attr",
          "attr": "value",
          "value": "Light Car Difference:\\s*[0-9,]+",
          "match": "regex"
        },
        {
          "website_id": "os",
          "selector": "textarea",
          "target": "attr",
          "attr": "value",
          "value": "Highest Toll:\\s*[0-9,]+",
          "match": "regex"
        },
        {
          "website_id": "os",
          "selector": "textarea",
          "target": "attr",
          "attr": "value",
          "value": "Light Car Ratio:\\s*0?\\.\\d+|Light Car Ratio:\\s*1\\.00",
          "match": "regex"
        }
      ]
    }
  },
  {
    // web_sheet_prozilla_hipass_toll_11
    // 1. 웹 브라우저에서 대상 사이트 열기
