    "task_id": "web_prozilla_nhis_word_01",
    "instruction": "Could you open NHIS premium calculator and check the final premium value. In Word, write a short note using the two-line format 'Service: NHIS Premium Check' and 'Result: [value]'; use PASS after you verify the premium value. In Prozilla OS, create ~/Documents/finance_report.txt and copy the Word note in the same two-line format.",
    "website": [
      {
        "id": "web",
        "url": "https://www.nhis.or.kr/nhis/minwon/initCtrbCalcView.do"
      },
      {
        "id": "word",
        "url": "http://localhost:3000/word"
      },
      {
        "id": "os",
        "url": "http://localhost:3000/"
      }
    ],
    "evaluation": {
      "mode": "dom",
      "operator": "and",
      "rules": [
        {
          "website_id": "os",
          "selector": "textarea",
          "target": "attr",
          "attr": "value",
          "value": "Service: NHIS Premium Check",
          "match": "contains"
        },
        {
          "website_id": "os",
          "selector": "textarea",
          "target": "attr",
          "attr": "value",
          "value": "Result: PASS",
          "match": "contains"
        }
      ]
    }
