    // web_sheet_prozilla_arxiv_01
    // 1. 웹 결과 확인
    // 2. 스프레드시트 값 반영
    // 3. 최종 내용 검토
    "task_id": "web_sheet_prozilla_arxiv_01",
    "instruction": "Could you open arXiv abstract page `https://arxiv.org/abs/1706.03762`. Record arXiv ID, title, first author, submitted year, primary category, and full subjects in Spreadsheet columns ArXiv ID, Title, First Author, Submitted Year, Primary Category, Subjects. Set `ID Prefix` to `=LEFT(A2,4)` and `Area Flag` to `=IF(E2=\"cs.CL\",\"NLP\",IF(E2=\"cs.CV\",\"VISION\",IF(E2=\"cs.LG\",\"ML\",IF(E2=\"cs.SD\",\"SOUND\",IF(E2=\"cs.NE\",\"NEURAL\",\"OTHER\")))))`. Save `~/Documents/arxiv_paper_001.txt` in the format 'ArXiv ID: 1706.03762 | Title: [value] | First Author: [value] | Submitted Year: [value] | Primary Category: [value] | Subjects: [value] | ID Prefix: [value] | Area Flag: [value]'.",
    "website": {
      "web": "https://arxiv.org/abs/1706.03762",
      "sheet": "local spreadsheet application",
      "os": "~/Documents/arxiv_paper_001.txt"
    },
    "evaluation": {
      "mode": "all",
      "operator": "and",
      "rules": [
        {
