[
  {
    "task_id": "MULTI-JUSO-SEARCH-001",
    "instruction": "I need to find the official address details for the National Museum of Korea (국립중앙박물관). Please search for '국립중앙박물관' on the juso.go.kr website. Extract its Road Name Address (도로명주소), Zip Code (우편번호), and English Road Name Address (영문 도로명주소). Save the results in the spreadsheet starting at A1 with headers 'Location', 'Road Name Address', 'Zip Code', and 'English Address'.",
    "website": [
      {
        "id": "web",
        "url": "https://www.juso.go.kr/"
      },
      {
        "id": "sheet",
        "url": "http://localhost:3000/spreadsheet"
      }
    ],
    "evaluation": {
      "mode": "spreadsheet",
      "operator": "and",
      "rules": [
        {
          "website_id": "sheet",
          "cell": "A1",
          "value": "(?i).*Location.*|.*장소.*|.*위치.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "B1",
          "value": "(?i).*Road.*|.*도로명.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "C1",
          "value": "(?i).*Zip.*|.*우편번호.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "D1",
          "value": "(?i).*English.*|.*영문.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "A2",
          "value": ".*국립중앙박물관.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "B2",
          "value": "(?i).*서빙고로\\s*137.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "C2",
          "value": ".*04383.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "D2",
          "value": "(?i).*137.*Seobinggo-ro.*",
          "match": "regex"
        }
      ]
    }
  },
  //1. Web에서 검색란 왼쪽 클릭
  //2. Web에서 '국립중앙박물관' 입력
  //3. Web에서 엔터 입력
  //4. Sheet의 A1 왼쪽 클릭
  //5. Sheet에서 'Location' 입력
  //6. Sheet의 B1 왼쪽 클릭
