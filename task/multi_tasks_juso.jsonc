  //16. Sheet의 C2 왼쪽 클릭
  //17. Sheet에서 '04383' 입력
  //18. Web에서 영문보기 버튼 왼쪽 클릭
  //19. Sheet의 D2 왼쪽 클릭
  //20. Sheet에서 '137 Seobinggo-ro, Yongsan-gu, Seoul' 입력
  {
    "task_id": "MULTI-JUSO-CONVERT-001",
    "instruction": "I have two old Korean lot-number addresses (지번주소) that I need to convert to the new Road Name Addresses (도로명주소). Address 1: '서울특별시 강남구 역삼동 737'. Address 2: '서울특별시 영등포구 여의도동 1-6 국회의사당역'. Please search for these on juso.go.kr and find their new road name addresses(도로명주소). Save them in the spreadsheet starting at A1 with headers 'Old Address' and 'New Address'.",
    "website": [
      {
        "id": "web",
        "url": "https://www.juso.go.kr/"
      },
      {
        "id": "sheet",
        "url": "http://localhost:3000/spreadsheet"
      }
    ],
    "evaluation": {
      "mode": "spreadsheet",
      "operator": "and",
      "rules": [
        {
          "website_id": "sheet",
          "cell": "A1",
          "value": "(?i).*Old.*|.*지번.*|.*구주소.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "B1",
          "value": "(?i).*New.*|.*Road.*|.*도로명.*|.*신주소.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "A2",
          "value": ".*역삼동.*737.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "B2",
          "value": ".*테헤란로\\s*152.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "A3",
          "value": ".*여의도동.*1-6.*국회의사당역.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "B3",
          "value": ".*국회대로\\s*758.*",
          "match": "regex"
        }
      ]
    }
  },
