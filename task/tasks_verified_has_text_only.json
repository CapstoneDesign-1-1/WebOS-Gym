[
  {
    "task_id": "prozilla_task_A_11",
    "instruction": "I want to hide all my desktop icons to keep my workspace clean. Please disable the desktop icons visibility option in the system settings. Keep the Settings window open.",
    "website": "http://localhost:3100",
    "evaluation": {
      "mode": "dom",
      "operator": "and",
      "rules": [
        {
          "selector": "div[class*='Option'] button[class*='Checkbox']:not([class*='Checked'])",
          "target": "html",
          "value": "^(?!.*Checked).*$",
          "match": "regex"
        }
      ]
    }
  },
  {
