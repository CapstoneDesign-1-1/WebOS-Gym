          "script": "(() => { try { const doc = univerAPI.getActiveDocument(); const text = doc._documentDataModel.getBody().dataStream.toLowerCase(); const runs = doc.getSnapshot().body.textRuns || []; const palette = { blue: ['#e1effe', '#a4cafe', '#3f83f8', '#1a56db', '#233876', '#0000ff'] }; const normalize = (rgb) => { const v = (rgb || '').toLowerCase().replace(/\\s+/g, ''); if (v.startsWith('#')) return v; const nums = v.match(/\\d+/g)?.slice(0, 3).map(Number); return nums?.length === 3 ? '#' + nums.map((n) => n.toString(16).padStart(2, '0')).join('') : v; }; const isColor = (rgb, name) => (palette[name] || []).includes(normalize(rgb)); const hasBlueBg = (target) => { const st = text.indexOf(target); const ed = st + target.length - 1; return st >= 0 && runs.some((r) => (r.st ?? 1e9) <= st && (r.ed ?? -1) >= ed && isColor(r.ts?.bg?.rgb, 'blue')); }; const markerOk = hasBlueBg('marker'); const activeClean = !hasBlueBg('active'); return markerOk && activeClean ? 'highlight-ok' : ''; } catch (e) { return ''; } })()",
          "value": "highlight-ok",
