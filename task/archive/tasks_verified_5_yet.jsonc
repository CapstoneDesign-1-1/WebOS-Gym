  // 4. E2 클릭
  // 5. E2에 수식 `=UPPER(C2)` 입력 후 Enter
  // 6. 요구된 출력 포맷을 순서대로 입력
  {
    // web_sheet_prozilla_cdc_child_bmi_30
    // 1. 웹 브라우저에서 대상 사이트 열기
    // 2. 스프레드시트 앱 열기
    // 3. Prozilla OS 앱 열기
    // 4. E2 클릭
    // 5. E2에 수식 `=UPPER(C2)` 입력 후 Enter
    // 6. 요구된 출력 포맷을 순서대로 입력
    "task_id": "web_sheet_prozilla_cdc_child_bmi_30",
    "instruction": "Could you open the CDC Child and Teen BMI Calculator. Use US Customary Units, enter Girl age 18 years 0 months, 5 ft 5 in, 235 lbs, then calculate. Copy results to Spreadsheet: B2=<BMI>, C2=<BMI Category>, D2=<BMI Percentile>. Set E2 to `=UPPER(C2)`; use E2 as `Upper Category`. In Prozilla OS, create the target text file and write sheet values in the format 'Scenario: Girl age 18 years 0 months, 5 ft 5 in, 235 lbs | BMI: <from sheet> | BMI Percentile: <from sheet> | Category: <from sheet> | Upper Category: <from sheet>'.",
    "website": [
      {
        "id": "web",
        "url": "https://www.cdc.gov/bmi/child-teen-calculator/index.html"
      },
      {
        "id": "sheet",
        "url": "http://localhost:3000/spreadsheet"
      },
      {
        "id": "os",
        "url": "http://localhost:3100/"
      }
    ],
    "evaluation": {
      "mode": "dom",
      "operator": "and",
      "rules": [
        {
          "website_id": "os",
          "selector": "textarea",
          "target": "attr",
          "attr": "value",
          "value": "Scenario: Girl age 18 years 0 months, 5 ft 5 in, 235 lbs",
          "match": "contains"
        },
        {
          "website_id": "os",
          "selector": "textarea",
          "target": "attr",
          "attr": "value",
          "value": "BMI:\\s*\\d+(?:\\.\\d+)?",
          "match": "regex"
        },
        {
          "website_id": "os",
          "selector": "textarea",
          "target": "attr",
          "attr": "value",
          "value": "BMI Percentile:\\s*(?:<\\s*)?[0-9]{1,3}(?:\\.[0-9]+)?(?:st|nd|rd|th)?(?:\\s*percentile|\\s*%)?",
          "match": "regex"
        },
        {
          "website_id": "os",
          "selector": "textarea",
          "target": "attr",
          "attr": "value",
          "value": "Category:\\s*(Underweight|Healthy Weight|Overweight|Obesity)",
          "match": "regex"
        },
        {
          "website_id": "os",
          "selector": "textarea",
          "target": "attr",
          "attr": "value",
          "value": "Upper Category:\\s*[A-Z ]+",
          "match": "regex"
        },
        {
          "mode": "console",
          "website_id": "os",
          "script": "(() => {\n  const text = document.querySelector('textarea')?.value || '';\n  const mB = text.match(/BMI:\\s*([0-9]+(?:\\.[0-9]+)?)/);\n  const mP = text.match(/BMI Percentile:\\s*(?:<\\s*)?([0-9]+(?:\\.[0-9]+)?)/i);\n  const mC = text.match(/Category:\\s*(Underweight|Healthy Weight|Overweight|Obesity)/);\n  if (!mB || !mP || !mC) return 'FAIL';\n  const bmi = parseFloat(mB[1]);\n  const pct = parseFloat(mP[1]);\n  const category = mC[1].trim();\n  if (Math.abs(bmi - 39.10) > 0.12) return 'FAIL';\n  if (!Number.isFinite(pct) || pct < 0 || pct > 100) return 'FAIL';\n  const mU = text.match(/Upper Category:\\s*([^|\\n]+)/); if (!mU || category.toUpperCase() !== mU[1].trim()) return 'FAIL';\n  return 'PASS';\n})();",
          "value": "PASS",
          "match": "exact"
        }
      ]
    }
  },
