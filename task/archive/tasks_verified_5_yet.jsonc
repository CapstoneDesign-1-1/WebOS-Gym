        "url": "http://localhost:3000/spreadsheet"
      },
      {
        "id": "os",
        "url": "http://localhost:3100/"
      }
    ],
    "evaluation": {
      "mode": "dom",
      "operator": "and",
      "rules": [
        {
          "website_id": "os",
          "selector": "textarea",
          "target": "attr",
          "attr": "value",
          "value": "Scenario: Multiple rates 30.00 hours at $18.00 and 15.00 hours at $24.00",
          "match": "contains"
        },
        {
          "website_id": "os",
          "selector": "textarea",
          "target": "attr",
