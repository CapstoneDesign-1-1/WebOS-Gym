  // 19. 요구된 출력 포맷을 순서대로 입력
  {
    "task_id": "MOEL-WEB-SHEET-OS-005",
    "instruction": "I am comparing severance entitlements across different countries and need to convert a Korean severance amount to its US wage equivalent based on a typical 44-hour work week to understand the total compensation gap between the two markets. Could you please compute the severance pay from the MoEL site for the period June 1, 2018 to February 18, 2021 (base salary 4.4M KRW each quarter, allowances 10K/20K/30K/40K KRW) and record it in spreadsheet cell E1; separately, determine the Total Weekly Wage using the DOL overtime calculator for a standard 44-hour week at $21/hr (based on personal wage circumstances) and record it in E2; convert that figure to KRW in E3 using '=E2*1400'; and then resolve the variance between E1 and E3 using the Prozilla OS system calculator?",
    "website": [
      {
        "id": "web",
        "url": "https://labor.moel.go.kr/cmmt/calRtrmnt.do"
      },
      {
        "id": "sheet",
        "url": "http://localhost:3000/spreadsheet"
      },
      {
        "id": "web2",
        "url": "https://webapps.dol.gov/elaws/otcalculator.htm"
      },
      {
        "id": "os",
        "url": "http://localhost:3000/prozilla"
      }
    ],
    "evaluation": {
      "mode": "dom",
      "operator": "and",
      "rules": [
        {
          "website_id": "os",
          "selector": "p[class*='_Preview_']",
          "target": "text",
          "value": "49011955",
          "match": "contains"
        }
      ]
    }
  },
