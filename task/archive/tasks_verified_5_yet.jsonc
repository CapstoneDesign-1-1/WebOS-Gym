        {
          "mode": "console",
          "website_id": "os",
          "script": "(() => {\n  const text = document.querySelector('textarea')?.value || '';\n  const mB = text.match(/BMI:\\s*([0-9]+(?:\\.[0-9]+)?)/);\n  const mP = text.match(/BMI Percentile:\\s*(?:<\\s*)?([0-9]+(?:\\.[0-9]+)?)/i);\n  const mC = text.match(/Category:\\s*(Underweight|Healthy Weight|Overweight|Obesity)/);\n  if (!mB || !mP || !mC) return 'FAIL';\n  const bmi = parseFloat(mB[1]);\n  const pct = parseFloat(mP[1]);\n  const category = mC[1].trim();\n  if (Math.abs(bmi - 23.43) > 0.12) return 'FAIL';\n  if (!Number.isFinite(pct) || pct < 0 || pct > 100) return 'FAIL';\n  const mD = text.match(/Distance from 20:\\s*([0-9]+(?:\\.[0-9]+)?)/); if (!mD) return 'FAIL'; const expected = Math.abs(bmi - 20); if (Math.abs(expected - parseFloat(mD[1])) >= 0.11) return 'FAIL';\n  return 'PASS';\n})();",
