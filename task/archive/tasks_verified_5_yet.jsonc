          "match": "regex"
        },
        {
          "target": "os_file",
          "path": "~/Documents/juso_address_009.txt",
          "text": "Road Keyword: 중앙로",
          "match": "contains"
        },
        {
          "target": "os_file",
          "path": "~/Documents/juso_address_009.txt",
          "text": "Address Check: MATCH",
          "match": "contains"
        }
      ]
    }
  },
  // web_prozilla_nhis_word_01
  // 1. 웹 브라우저에서 대상 사이트 열기
  // 2. Prozilla OS 앱 열기
  // 3. 파일 `~/Documents/finance_report.txt` 생성 또는 열기
  // 4. 요구된 출력 포맷을 순서대로 입력
  // 5. 웹 결과 확인
  // 6. 스프레드시트 값 반영
  // 7. 최종 내용 검토
  {
    // web_sheet_prozilla_juso_10
    // 1. 웹 결과 확인
    // 2. 스프레드시트 값 반영
    // 3. 최종 내용 검토
    "task_id": "web_sheet_prozilla_juso_10",
    "instruction": "Could you open Juso address search at https://www.juso.go.kr/. Search for `제주특별자치도 제주시 문연로 6`. Select the first result whose road address contains `제주특별자치도` and \"제주시\", `문연로`, and building number `6`. Copy the postal code, road address, and jibun address if shown. Record them in Spreadsheet columns Search Query, Postal Code, Road Address, and Jibun Address. Set `Zip Prefix` to `=LEFT(B2,2)` and `Road Keyword` to `문연로`, and `Address Check` to `=IF(AND(ISNUMBER(SEARCH(\"제주특별자치도\",C2)),ISNUMBER(SEARCH(\"문연로\",C2)),ISNUMBER(SEARCH(\"6\",C2))),\"MATCH\",\"CHECK\")`. Save `~/Documents/juso_address_010.txt` in the format 'Scenario: 제주특별자치도청 address lookup | Search Query: 제주특별자치도 제주시 문연로 6 | Postal Code: [value] | Road Address: [value] | Jibun Address: [value] | Zip Prefix: [value] | Road Keyword: 문연로 | Address Check: [value]'.",
    "website": {
      "web": "https://www.juso.go.kr/",
      "sheet": "local spreadsheet application",
      "os": "~/Documents/juso_address_010.txt"
    },
    "evaluation": {
      "mode": "all",
      "operator": "and",
      "rules": [
        {
          "target": "os_file",
          "path": "~/Documents/juso_address_010.txt",
          "text": "Scenario: 제주특별자치도청 address lookup",
          "match": "contains"
        },
        {
          "target": "os_file",
          "path": "~/Documents/juso_address_010.txt",
          "text": "Search Query: 제주특별자치도 제주시 문연로 6",
          "match": "contains"
        },
        {
          "target": "os_file",
          "path": "~/Documents/juso_address_010.txt",
          "text_regex": "Postal Code:\\s*\\d{5}",
          "match": "regex"
        },
        {
          "target": "os_file",
          "path": "~/Documents/juso_address_010.txt",
          "text_regex": "Road Address:\\s*.*제주특별자치도.*문연로.*6",
          "match": "regex"
        },
        {
          "target": "os_file",
          "path": "~/Documents/juso_address_010.txt",
          "text_regex": "Road Address:\\s*.*제주시.*",
          "match": "regex"
        },
        {
          "target": "os_file",
          "path": "~/Documents/juso_address_010.txt",
          "text_regex": "Jibun Address:\\s*.+",
          "match": "regex"
        },
        {
          "target": "os_file",
          "path": "~/Documents/juso_address_010.txt",
          "text_regex": "Zip Prefix:\\s*\\d{2}",
          "match": "regex"
        },
        {
          "target": "os_file",
          "path": "~/Documents/juso_address_010.txt",
          "text": "Road Keyword: 문연로",
          "match": "contains"
        },
        {
          "target": "os_file",
          "path": "~/Documents/juso_address_010.txt",
          "text": "Address Check: MATCH",
          "match": "contains"
        }
      ]
    }
  },
  // web_prozilla_nhis_word_01
  // 1. 웹 브라우저에서 대상 사이트 열기
  // 2. Prozilla OS 앱 열기
  // 3. 파일 `~/Documents/finance_report.txt` 생성 또는 열기
  // 4. 요구된 출력 포맷을 순서대로 입력
  // 5. 웹 결과 확인
  // 6. 스프레드시트 값 반영
  // 7. 최종 내용 검토
  {
    // web_prozilla_nhis_word_01
    // 1. 웹 브라우저에서 대상 사이트 열기
    // 2. Prozilla OS 앱 열기
    // 3. 파일 `~/Documents/finance_report.txt` 생성 또는 열기
    // 4. 요구된 출력 포맷을 순서대로 입력
    // 5. 웹 결과 확인
    // 6. 스프레드시트 값 반영
    // 7. 최종 내용 검토
    "task_id": "web_prozilla_nhis_word_01",
    "instruction": "Could you open NHIS premium calculator and check the final premium value. In Word, write a short note using the two-line format 'Service: NHIS Premium Check' and 'Result: [value]'; use PASS after you verify the premium value. In Prozilla OS, create ~/Documents/finance_report.txt and copy the Word note in the same two-line format.",
    "website": [
      {
        "id": "web",
        "url": "https://www.nhis.or.kr/nhis/minwon/initCtrbCalcView.do"
      },
      {
        "id": "word",
        "url": "http://localhost:3000/word"
      },
      {
        "id": "os",
        "url": "http://localhost:3000/"
      }
    ],
    "evaluation": {
      "mode": "dom",
      "operator": "and",
      "rules": [
        {
          "website_id": "os",
          "selector": "textarea",
          "target": "attr",
          "attr": "value",
          "value": "Service: NHIS Premium Check",
          "match": "contains"
        },
        {
          "website_id": "os",
          "selector": "textarea",
          "target": "attr",
          "attr": "value",
          "value": "Result: PASS",
          "match": "contains"
        }
      ]
    }
  },
  // prozillaos B,C tasks - 태호, 지연
