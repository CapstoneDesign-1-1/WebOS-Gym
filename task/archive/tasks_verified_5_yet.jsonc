    // 13. 요구된 출력 포맷을 순서대로 입력
    "task_id": "web_sheet_prozilla_cdc_child_bmi_01",
    "instruction": "Could you open the CDC Child and Teen BMI Calculator. Use US Customary Units, enter Boy age 8 years 0 months, 4 ft 4 in, 48 lbs, then calculate. Copy results to Spreadsheet: B2=<BMI>, C2=<BMI Category>, D2=<BMI Percentile>. Set E2 to `=ROUND(B2,0)` and F2 to `=IF(C2=\"Underweight\",\"LOW\",IF(C2=\"Healthy Weight\",\"OK\",IF(C2=\"Overweight\",\"WATCH\",IF(C2=\"Obesity\",\"HIGH\",\"SEVERE\"))))`. Use E2 as `Rounded BMI` and F2 as `Category Flag`. In Prozilla OS, create the target text file and write sheet values in the format 'Scenario: Boy age 8 years 0 months, 4 ft 4 in, 48 lbs | BMI: <from sheet> | BMI Percentile: <from sheet> | Category: <from sheet> | Rounded BMI: <from sheet> | Category Flag: <from sheet>'.",
    "website": [
      {
        "id": "web",
        "url": "https://www.cdc.gov/bmi/child-teen-calculator/index.html"
      },
      {
        "id": "sheet",
        "url": "http://localhost:3000/spreadsheet"
      },
      {
        "id": "os",
        "url": "http://localhost:3100/"
      }
    ],
    "evaluation": {
      "mode": "dom",
      "operator": "and",
      "rules": [
        {
          "website_id": "os",
          "selector": "textarea",
          "target": "attr",
          "attr": "value",
          "value": "Scenario: Boy age 8 years 0 months, 4 ft 4 in, 48 lbs",
          "match": "contains"
        },
        {
          "website_id": "os",
          "selector": "textarea",
          "target": "attr",
          "attr": "value",
          "value": "BMI:\\s*\\d+(?:\\.\\d+)?",
          "match": "regex"
        },
        {
          "website_id": "os",
          "selector": "textarea",
          "target": "attr",
          "attr": "value",
          "value": "BMI Percentile:\\s*(?:<\\s*)?[0-9]{1,3}(?:\\.[0-9]+)?(?:st|nd|rd|th)?(?:\\s*percentile|\\s*%)?",
          "match": "regex"
        },
        {
          "website_id": "os",
          "selector": "textarea",
          "target": "attr",
          "attr": "value",
          "value": "Category:\\s*(Underweight|Healthy Weight|Overweight|Obesity)",
          "match": "regex"
        },
        {
          "website_id": "os",
          "selector": "textarea",
          "target": "attr",
          "attr": "value",
          "value": "Category Flag:\\s*(LOW|OK|WATCH|HIGH|SEVERE)",
          "match": "regex"
        },
        {
          "website_id": "os",
          "selector": "textarea",
          "target": "attr",
          "attr": "value",
          "value": "Rounded BMI:\\s*\\d+",
          "match": "regex"
        },
        {
          "mode": "console",
          "website_id": "os",
          "script": "(() => {\n  const text = document.querySelector('textarea')?.value || '';\n  const mB = text.match(/BMI:\\s*([0-9]+(?:\\.[0-9]+)?)/);\n  const mP = text.match(/BMI Percentile:\\s*(?:<\\s*)?([0-9]+(?:\\.[0-9]+)?)/i);\n  const mC = text.match(/Category:\\s*(Underweight|Healthy Weight|Overweight|Obesity)/);\n  const mR = text.match(/Rounded BMI:\\s*([0-9]+)/);\n  const mF = text.match(/Category Flag:\\s*(LOW|OK|WATCH|HIGH|SEVERE)/);\n  if (!mB || !mP || !mC || !mR || !mF) return 'FAIL';\n  const bmi = parseFloat(mB[1]);\n  const pct = parseFloat(mP[1]);\n  const category = mC[1].trim();\n  const rounded = parseInt(mR[1], 10);\n  const flag = mF[1];\n  if (Math.abs(bmi - 12.48) > 0.12) return 'FAIL';\n  if (!Number.isFinite(pct) || pct < 0 || pct > 100) return 'FAIL';\n  const expectedFlag = category === 'Underweight' ? 'LOW' : category === 'Healthy Weight' ? 'OK' : category === 'Overweight' ? 'WATCH' : category === 'Obesity' ? 'HIGH' : 'SEVERE';\n  if (!Number.isFinite(rounded) || Math.round(bmi) !== rounded || flag !== expectedFlag) return 'FAIL';\n  return 'PASS';\n})();",
          "value": "PASS",
          "match": "exact"
        }
      ]
    }
  },
