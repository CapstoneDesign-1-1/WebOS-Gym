  {
    "task_id": "web_sheet_word_cdc_child_bmi_10",
    "instruction": "I want to check the CDC BMI category for a 12-year-old girl at 5 ft 0 in and 120 lbs. Could you use the CDC Child and Teen BMI Calculator (US Customary), copy the BMI, percentile, and category into cells B2–B4 in the spreadsheet, round the BMI to the nearest whole number as Rounded BMI in B5 and map the category to a Category Flag (Underweight→LOW / Healthy Weight→OK / Overweight→WATCH / Obesity→HIGH / other→SEVERE) in B6, then save to Word in the format 'Scenario: Girl age 12 years 0 months, 5 ft 0 in, 120 lbs | BMI: [value] | BMI Percentile: [value] | Category: [value] | Rounded BMI: [value] | Category Flag: [value]'?",
    "website": [
      {"id": "web", "url": "https://www.cdc.gov/bmi/child-teen-calculator/index.html"},
      {"id": "sheet", "url": "http://localhost:3000/spreadsheet"},
      {"id": "word", "url": "http://localhost:3000/word"}
    ],
    "evaluation": {
      "operator": "and",
      "rules": [
        {"website_id": "word", "value": "Scenario: Girl age 12 years 0 months, 5 ft 0 in, 120 lbs", "match": "contains"},
        {"website_id": "word", "value": "BMI: 23.4", "match": "contains"},
        {"website_id": "word", "value": "BMI Percentile:\\s*.+", "match": "regex"},
        {"website_id": "word", "value": "Category: Overweight", "match": "contains"},
        {"website_id": "word", "value": "Rounded BMI: 23", "match": "contains"},
        {"website_id": "word", "value": "Category Flag: WATCH", "match": "contains"}
      ]
    }
  },

