  // =================================================================
  // 1. ARXIV TASKS
  // counts: 4
  // =================================================================

  {
    "task_id": "web_sheet_word_arxiv_01",
    "instruction": "I need to catalog the NLP paper 'Attention Is All You Need' for my research library. Could you find it on arXiv, fill cells A2–D2 with its ArXiv ID, First Author, Submitted Year, and Primary Category, put the first 4 characters of the ArXiv ID as ID Prefix in E2 and map the primary category to an Area Flag (cs.CL→NLP / cs.CV→VISION / cs.LG→ML / other→OTHER) in F2, then record all fields in the Word document in the format 'ArXiv ID: [value] | First Author: [value] | Year: [value] | Category: [value] | ID Prefix: [value] | Area Flag: [value]'?",
    "website": [
      {"id": "web", "url": "https://arxiv.org"},
      {"id": "sheet", "url": "http://localhost:3000/spreadsheet"},
      {"id": "word", "url": "http://localhost:3000/word"}
    ],
    "evaluation": {
      "operator": "and",
      "rules": [
        {"website_id": "word", "value": "ArXiv ID: 1706.03762", "match": "contains"},
        {"website_id": "word", "value": "First Author: Ashish Vaswani", "match": "contains"},
        {"website_id": "word", "value": "Year: 2017", "match": "contains"},
        {"website_id": "word", "value": "Category: cs.CL", "match": "contains"},
        {"website_id": "sheet", "mode": "spreadsheet", "cell": "E2", "value": "1706"},
        {"website_id": "sheet", "mode": "spreadsheet", "cell": "F2", "value": "NLP"}
      ]
    }
  },

