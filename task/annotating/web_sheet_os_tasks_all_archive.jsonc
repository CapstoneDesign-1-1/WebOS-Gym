    // 14. B3 클릭
    // 15. B3에 값 1 입력
    // 16. B4 클릭
    // 17. B4에 수식 `=SUM(B2:B3)` 입력 후 Enter
    // 18. 파일 `~/Documents/finance_report.txt` 생성 또는 열기
    // 19. 요구된 출력 포맷을 순서대로 입력
    "task_id": "web_sheet_prozilla_nhis_01",
    "instruction": "Could you open NHIS overseas departure premium exemption check. Run two checks: A) departure 2026.05.12 and entry 2026.05.13, B) departure 2026.05.12 and entry 2026.11.20. In Spreadsheet, record the two case results in cells A1:B3 with A1='Case', B1='Flag', A2='A', and A3='B', placing the first case flag in B2 and the second case flag in B3, and compute B4 with '=SUM(B2:B3)'. In Prozilla OS, create ~/Documents/finance_report.txt and write the spreadsheet results in the format 'CaseA Flag: [value]', 'CaseB Flag: [value]', 'Eligible Count: [value]'.",
    "website": [
      {
        "id": "web",
        "url": "https://www.nhis.or.kr/nhis/minwon/initCtrbCalcView.do"
      },
      {
        "id": "sheet",
        "url": "http://localhost:3000/spreadsheet"
      },
      {
        "id": "os",
        "url": "http://localhost:3100/"
      }
    ],
    "evaluation": {
      "mode": "dom",
      "operator": "and",
      "rules": [
        {
          "website_id": "os",
          "selector": "textarea",
          "target": "attr",
          "attr": "value",
          "value": "CaseA Flag: 0",
          "match": "contains"
        },
        {
          "website_id": "os",
          "selector": "textarea",
          "target": "attr",
          "attr": "value",
          "value": "CaseB Flag: 1",
          "match": "contains"
        },
        {
          "website_id": "os",
          "selector": "textarea",
          "target": "attr",
          "attr": "value",
          "value": "Eligible Count: 1",
          "match": "contains"
        }
      ]
    }
  },
