  "hoare:v1:bbdb92ba6e1245a39a8a3a90c6cb027442a35822ca54ec49f2ccfee7fc43ebe4": "Type Deadline confirmed in the document.",
  "hoare:v1:be0f9a1969ecc622c54e5f2d36e9b861f9a07120ccf7b835409376f1fd21cf34": "Create this draft with extra blank lines between the entries: \"north\", \"south\", and \"east\". Then remove the blank lines so only one line break remains between entries.",
  "hoare:v1:be8518fd3b0f075d83b4b9ec85154b977a014c5ae707786285b57778c9ba8027": "Type Internal Memo on a single line.",
  "hoare:v1:bf1c9145f8a9a9943c4f595eaa697b26cdac2d24213934a7c061455a85fa30b9": "Write please review the green section.",
  "hoare:v1:bf3609fc36b5eb8fc2473736203abfa8039e6af1c3d7cbb323967cde74afb5c8": "Create two paragraphs: \"compact note\" and \"spaced note\". Then set only the second paragraph to double line spacing.",
  "hoare:v1:bf7ba3fc5af2efc53213c584a456dea7aed05d18bf2be7c5bb92760d77d104a1": "Please write \"moss amber\" and make \"moss\" green while making \"amber\" orange.",
  "hoare:v1:c41443401278fdaceddd6e124aa92e18a79be1e903ecb81c230fe712fa72486d": "Create the comma-separated text \"Name, Score, Ilya, 87, Noor, 91\". Then convert it into a table with 3 rows and 2 columns so the first row is Name, Score, the second row is Ilya, 87, and the third row is Noor, 91.",
  "hoare:v1:c5059483d2e68a80ea934df8722c3ff6004dda62dde865462d936c078e9affe5": "Underline the word “timeline”.",
  "hoare:v1:c50cd4f303c0ed00f4bfae2dd908c2be07edbcadb076eef204921e6759fb2d7f": "Create a two-line note with \"Checkpoint Log\" on the first line and \"notes pending\" on the second line. Make the first line bold.",
  "hoare:v1:c5fe3258ec313527dfd4195ccf90c87069a1279d01066ad06e34ef4f5a8cbd79": "Underline “Field Notes”.",
  "hoare:v1:c6bf0b602abbdf2bbf8396a9f1b4f6049429e2f056d8b55d7eda3d8ecbe67a5f": "Write moss amber and make moss green.",
  "hoare:v1:c7402a637d18e2b0680b726685a37d0122263d0892c83e48fc65b0341ca9e2c4": "Create the document with exactly these three paragraphs: “Opening frame: scope and context”, “Evidence block: signals and details”, and “Decision note: action and owner”, and set the first paragraph to single spacing.",
  "hoare:v1:c78b94da80308a808a28a76d91b68d84d17ed995d279b3106b534a7376992b06": "Type NH3 and format only the 3 as subscript.",
  "hoare:v1:c89238a38e3d20027072edbcb454abc6f0842004c6d03600c648e3ae185def11": "Create the document body text exactly as Name, Score, Ilya, 87, Noor, 91.",
  "hoare:v1:ca43b43bc71ebe461b8f1941436d133ff247a7318ebfa800467c35dc8548a86f": "Select “priority marker” and change its font size to 18.",
  "hoare:v1:cbd7f8743ad8d0fb4fd67fc11276e1ff90bd4dd159997ff414da8ff10ba2aab0": "Type schedule ready and set it in Tahoma.",
  "hoare:v1:ccdde142b38bbc052b090d563a608d905e22954a80bc437072bf41a1171aa909": "Please write \"Deadline confirmed\" and underline only the word \"Deadline\".",
  "hoare:v1:d19759b21923d529d357693146dd152c1392e8f9d88c2c4077579d1c6993770a": "Write Status is nearly complete in the document body.",
  "hoare:v1:d29cc603cc9730dd66e6bfdae6ec183ff272ca673191c18400f6cb384da76fb1": "Write \"small note big note plain note\" on one line. Then change only \"big note\" to font size 18.",
  "hoare:v1:d42e2a9d8ac815f1d58de20154f755ef1e03f9832d28399372fe7a4e4c82a811": "Set the second paragraph to double spacing.",
  "hoare:v1:d5440e0c2339b8c15f7d30496e4bd4c0cd1fd57bddadf758d5f4fbd30df15d49": "Type schedule ready in the document.",
  "hoare:v1:d67c2c2d0a25b889bdd0707305bdbbb9cdff1fe04a04314f53702e5aa055302f": "Set paragraph 2 to double spacing, paragraph 3 to 1.5 spacing, and make all document text font size 12.",
  "hoare:v1:d75f201c881beb3b327e84f03444c890549ad7fbfeba085df6f97a34b81fd950": "Convert the comma-separated text into a 3x2 table with Name and Score in the first row, Ilya and 87 in the second row, and Noor and 91 in the third row.",
  "hoare:v1:d87032737ed45ee94bb68a699c3a61302a232bc3f677c92a0fb3fe14c95c9603": "Italicize only “phase two review.”",
  "hoare:v1:d88caed5bdb10833c8d585c0063f9a67c389ba170d72d11d6cd24e901e09fe5a": "Create three paragraphs in this order: alpha note, beta note, and gamma note, and set the first paragraph’s line spacing to 1.15.",
  "hoare:v1:d9254632da51b2e1f3c30fe2c688517a12e9b0b79189c24dd68519e97f59054e": "Underline only the word “Deadline”.",
  "hoare:v1:dadd841484c49f71a707f0c1d3941cf2b470851602a8b018fba82bcfa9e48135": "Underline only 2026-08-14 in “Submit by 2026-08-14”.",
  "hoare:v1:dba37e95b2e224faa0800fe639f1a5f4ef237a25dded1f8a9c117c184410c4bb": "Type shift this memo on a single line.",
  "hoare:v1:df242512398cd107b605c99a98f31379ac4cb27ea716b6db321e2bf5a061550e": "Italicize only “The Silent Harbor” in the sentence.",
  "hoare:v1:e1f1db3df050b81c6d619d3d4f14b1aa12d6325e804a8b0319b2b759a91e732e": "Type Signal Ledger on a single line.",
  "hoare:v1:e6031d1c4436c3410361f93c2a3239d44b7227b19fee062ccc55dd6302ef40f2": "Create three lines with \"phase one\", \"phase two review\", and \"phase three\". Make only the middle line italic.",
  "hoare:v1:e713760eced115b0511679cfa3f07d8cac5f93b94c306341feb1022e87a31b37": "Select “schedule ready” and change its font to Tahoma.",
  "hoare:v1:e725d5e25f24fbb385afd5bcdef2f4f8294b4f960be9c6a5fcbd8a1071d419d4": "Right-align the paragraph.",
  "hoare:v1:e9258b30129c1aa49e97d949a5af1a1843ea4c6f075d96cd15f71f5d253dba77": "Format “schedule ready” in Tahoma with font size 15.",
  "hoare:v1:ecc38fccf097aa83479115705a648b77fcba3c40a57c50e483dd1f965fcac22e": "Change the font size of “schedule ready” to 15.",
  "hoare:v1:ed24363466d056993cced8134ac02afc6ad0ca7d1f7ef3acb66ec4a126707e4c": "Please type \"balanced report note\" on a single line and justify-align that paragraph.",
  "hoare:v1:ed8429d9a33e3c00710b65414813819993be6cea3b045ad73b2f534352b62b25": "Justify-align the paragraph.",
  "hoare:v1:ed93cac0d04faaceae5f208647f845f2ef7672b184586fefabedb8de61d8f378": "Type a2 + b2 and format the first 2 as superscript.",
  "hoare:v1:ede34c3adfaf8cfffc83652f65ce6bc1ff1d2c0aa36b07afdd336812af197437": "Create the document with exactly two paragraphs: plain note remains left and focus line moves inward.",
  "hoare:v1:ee79c8f1717a726497ebfb050ce013e2a0ed0b8172a7808001d4fcb65028e199": "Make only “summary” italic and set it to font size 16.",
  "hoare:v1:f0b4ef259044404d9feb1080bc9d80c052be96726a15cd68069eef3232dacc23": "Apply Verdana to the text “status memo”.",
  "hoare:v1:f163a6d904cda92895af71f284287102b1eec45119cac42860486a5e6b5937f3": "Create three paragraphs in this order: \"alpha note\", \"beta note\", and \"gamma note\". Set their line spacing to 1.15, 1.5, and 2 respectively.",
  "hoare:v1:f219a0990b0dcd79dc71e299302705b5b601163cc2c1e9311f47876b2d6eb2d5": "Set the line spacing of the three paragraphs to 1.15, 1.5, and 2 respectively.",
  "hoare:v1:f68c5553073a45f7506abeebc1ed6990a84dad1b1e424e2650e58830d4ae5223": "Create three paragraphs: “reference note”, “archive this note”, and “closing note”.",
  "hoare:v1:f6b84118873ea634449f5b52dbfa2d4103dcda8dc8462445c5cf6aa1c433d907": "Create a two-line note with Field Notes on the first line and draft copy on the second line, and make Field Notes bold.",
  "hoare:v1:f84f4940520e9780063f972c5a50906f8361ec14c9f9ae458e945b26d78b320d": "Set the second paragraph’s line spacing to 1.5.",
  "hoare:v1:f9a70badf42df566da7f8c62eac37e105470558bfd5df25428b1472638810bf3": "Make “moss” green.",
  "hoare:v1:fb957e4d4bec575f64879c0845443ee47db6116cd5ad2e5f8a6a3a945135cde0": "Type priority marker in the document.",
  "hoare:v1:fc7a21ee280a626f2865b21d33a90ca96f4694dd767911773cd179210091c701": "Write “Check budget and timeline” and underline the word “budget.”",
  "hoare:v1:ffabd2bd6b954f58156d37612bfa216a88619f8fb1f08dfdfeed0121bbfbf50a": "Make only the labels Owner, Stage, and Flag bold."
