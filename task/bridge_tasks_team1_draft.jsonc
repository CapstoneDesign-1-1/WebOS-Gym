    {
      "task_id": "bridge_task_1_WO_04",
      "instruction": "Find the toll fee for a Class 1 vehicle traveling from Seoul Tollgate to Busan Tollgate on the HiPass website (hipass.co.kr). Then, in ProzillaOS, open '~/Documents/text.txt' using the Notes app and write the result in the format 'Toll Fee: [value]'. Keep the file open.",
      "website": [
        {
          "id": "web",
          "url": "https://www.hipass.co.kr/board/TollPaySearchList.do"
        },
        {
          "id": "os",
          "url": "http://localhost:3000/prozilla"
        }
      ],
      "evaluation": {
        "mode": "dom",
        "operator": "and",
        "rules": [
          {
            "website_id": "os",
            "selector": "p[class*='ProzillaOS-WindowTitle']",
            "target": "text",
            "value": "text.txt",
            "match": "contains"
          },
          {
            "website_id": "os",
            "selector": "textarea[class*='_View_']",
            "target": "text",
            "value": "Toll Fee:\\s*[\\d,]+",
            "match": "regex"
          }
        ]
      }
    },
    {
      "task_id": "bridge_task_1_WO_05",
