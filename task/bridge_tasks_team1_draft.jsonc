[
    // WO tasks -> Web_Os_tasks.jsonc
    {
      "task_id": "bridge_task_1_WO_01",
      "instruction": "Find the exact postal code for the address '서울특별시 종로구 세종대로 175' on the Road Address System (juso.go.kr). Then, in ProzillaOS, open '~/Documents/text.txt' using the Notes app and write the result in the format 'Postal Code: [value]'. Keep the file open.",
      "website": [
        {
          "id": "web",
          "url": "https://www.juso.go.kr/"
        },
        {
          "id": "os",
          "url": "http://localhost:3000/prozilla"
        }
      ],
      "evaluation": {
        "mode": "dom",
        "operator": "and",
        "rules": [
          {
            "website_id": "os",
            "selector": "p[class*='ProzillaOS-WindowTitle']",
            "target": "text",
            "value": "text.txt",
            "match": "contains"
          },
          {
            "website_id": "os",
            "selector": "textarea[class*='_View_']",
            "target": "text",
            "value": "Postal Code: 03172",
            "match": "contains"
          }
        ]
      }
    },
