    // OW tasks -> need initialize ProzillaOS state
    {
      "task_id": "bridge_task_1_OW_01",
      "instruction": "In ProzillaOS, open '~/Documents/text.txt' using the Notes app. The file contains the Korean road address '서울특별시 종로구 세종대로 175'. Copy that address and look it up on the Road Address System (juso.go.kr) to verify its postal code.",
      "website": [
        {
          "id": "os",
          "url": "http://localhost:3000/prozilla"
        },
        {
          "id": "web",
          "url": "https://www.juso.go.kr/"
        }
      ],
      "evaluation": {
        "mode": "dom",
        "operator": "and",
        "rules": [
          {
            "website_id": "web",
            "selector": ".zipNo, .number",
            "target": "text",
            "value": "03172",
            "match": "contains",
            "normalize_space": true
          }
        ]
      }
    },
    {
      "task_id": "bridge_task_1_OW_02",
      "instruction": "In ProzillaOS, open '~/Documents/text.txt' using the Notes app. The file contains the Korean road address '경기도 성남시 분당구 판교역로 166'. Copy that address and look it up on the Road Address System (juso.go.kr) to verify its postal code.",
      "website": [
        {
          "id": "os",
          "url": "http://localhost:3000/prozilla"
        },
        {
          "id": "web",
          "url": "https://www.juso.go.kr/"
        }
      ],
      "evaluation": {
        "mode": "dom",
        "operator": "and",
        "rules": [
          {
            "website_id": "web",
            "selector": ".zipNo, .number",
            "target": "text",
            "value": "13529",
            "match": "contains",
            "normalize_space": true
          }
        ]
      }
    },
    {
      "task_id": "bridge_task_1_OW_03",
      "instruction": "In ProzillaOS, open '~/Documents/text.txt' using the Notes app. The file contains the departure IC name '서울' and the destination IC name '부산'. Use those names to look up the toll fee for a Class 1 vehicle on the HiPass website (hipass.co.kr) and verify the result.",
      "website": [
        {
          "id": "os",
          "url": "http://localhost:3000/prozilla"
        },
        {
          "id": "web",
          "url": "https://www.hipass.co.kr/board/TollPaySearchList.do"
        }
      ],
      "evaluation": {
        "mode": "dom",
        "operator": "and",
        "rules": [
          {
            "website_id": "web",
            "target": "text",
            "value": "서울",
            "match": "contains"
          },
          {
            "website_id": "web",
            "target": "text",
            "value": "부산",
            "match": "contains"
          },
          {
            "website_id": "web",
            "target": "text",
            "value": "1종",
            "match": "contains"
          }
        ]
      }
    }
  ]
  