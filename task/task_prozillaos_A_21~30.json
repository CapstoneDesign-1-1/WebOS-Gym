[
  {
    "task_id": "prozilla_task_A_21",
    "instruction": "Open the App Center, browse apps with the 'Personalization' filter. And change the content of text.txt file to 'Presonalization' filtered app name and save the file.",
    "website": "http://localhost:3000",
    "evaluation": {
      "mode": "dom",
      "operator": "and",
      "rules": [
        {
          "selector": "p[class*='ProzillaOS-WindowTitle']",
          "target": "text",
          "value": "text.txt",
          "match": "contains"
        },
        {
          "selector": "textarea[class*='_View_']",
          "target": "text",
          "value": "(?i)Maths",
          "match": "regex"
        }
      ]
    }
  },
  {
    "task_id": "prozilla_task_A_22",
    "instruction": "Unpin 'Terminal' from the taskbar, then disable 'Show icons' in Desktop.",
    "website": "http://localhost:3000",
    "evaluation": {
      "mode": "dom",
      "operator": "and",
      "rules": [
        {
          "selector": "button[title='Terminal']",
          "target": "class",
          "value": "Hidden",
          "match": "contains"
        },
        {
          "selector": "div:has(p:has-text('Show icons')) button[class*='Checkbox']",
          "target": "class",
          "value": "^(?!.*Checked).*$",
          "match": "regex"
        }
      ]
    }
  },
  {
    "task_id": "prozilla_task_A_23",
    "instruction": "Change the theme to 'Grape', update the wallpaper to 'Wallpaper6', and minimize all windows.",
    "website": "http://localhost:3000",
    "evaluation": {
      "mode": "dom",
      "operator": "and",
      "rules": [
        {
          "selector": "select[aria-label='theme']",
          "target": "attr",
          "attr": "value",
          "value": "Grape",
          "match": "exact"
        },
        {
          "selector": "img[alt='Desktop wallpaper']",
          "target": "attr",
          "attr": "src",
          "value": "mesh-gradient-wallpaper-red-purple",
          "match": "contains"
        },
        {
          "selector": "div[class*='WindowView']:has(p:has-text('Settings'))",
          "target": "class",
          "value": "Minimized",
          "match": "contains"
        }
      ]
    }
  },
  {
    "task_id": "prozilla_task_A_24",
    "instruction": "Pin 'Wordle' to the taskbar, and enable it to launch automatically upon system startup.",
    "website": "http://localhost:3000",
    "evaluation": {
      "mode": "dom",
      "operator": "and",
      "rules": [
        {
          "selector": "button[title='Wordle']",
          "target": "class",
          "value": "^(?!.*Hidden).*$",
          "match": "regex"
        },
        {
          "selector": "button:has-text('Wordle') div[class*='Checkbox']",
          "target": "class",
          "value": "Checked",
          "match": "contains"
        }
      ]
    }
  },
  {
    "task_id": "prozilla_task_A_25",
    "instruction": "Check the currently used virtual drive space size (in KB) in Storage. Overwrite '~/Documents/text.txt' with this numeric value and save it.",
    "website": "http://localhost:3000",
    "evaluation": {
      "mode": "dom",
      "operator": "and",
      "rules": [
        {
          "selector": "p[class*='ProzillaOS-WindowTitle']",
          "target": "text",
          "value": "text.txt",
          "match": "contains"
        },
        {
          "selector": "textarea[class*='_View_']",
          "target": "text",
          "value": "^\\d+(\\.\\d+)?$",
          "match": "regex"
        }
      ]
    }
  },
  {
