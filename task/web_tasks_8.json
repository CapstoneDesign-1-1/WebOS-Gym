        "task_id": "HIPASS-DISTANCE-001",
        "instruction": "I want to know the distance from 동서울 to 광주, but I'm not sure how to check it. Can you help me?",
        "website": "https://www.hipass.co.kr/board/TollPaySearchList.do",
        "evaluation": {
            "rules": [
                {
                    "selector": "#tb_route_list > tr:nth-child(4) > td:nth-child(2)",
                    "target": "text",
                    "value": "299.65km",
                    "match": "exact"
                },
                {
                    "target": "text",
                    "value": "동서울",
                    "match": "contains"
                },
                {
                    "target": "text",
                    "value": "광주",
                    "match": "contains"
                }
            ]
        }
    },
