  {
    "task_id": "prozilla_file_edit_01",
    "instruction": "Modify 'fizzbuzz.sh' inside the Scripts folder so that 'Buzz' is output when 'i' is divisible by 7. And let me know it is done.",
    "website": "http://localhost:3100",
    "evaluation": {
      "rules": [
        {
          "mode": "console",
          "script": "(() => {\n  const has = [...document.querySelectorAll(\"p[class*='ProzillaOS-WindowTitle']\")].find((el) => el.textContent.includes(\"fizzbuzz.sh\"));\n  return has?.textContent.trim() ?? \"\";\n})();\n",
          "value": "fizzbuzz.sh",
          "match": "exact"
        },
        {
          "mode": "console",
          "script": "(() => {\n  const text = document.querySelector(\"textarea[class*='_View_']\")?.value ?? \"\";\n  return text.includes(\"i % 7 == 0\") ? \"i % 7 == 0\" : \"\";\n})();\n",
          "value": "i % 7 == 0",
          "match": "exact"
        },
        {
          "mode": "console",
          "script": "(() => {\n  const text = document.querySelector(\"textarea[class*='_View_']\")?.value ?? \"\";\n  return text.includes('OUTPUT+=\"Buzz\"') ? 'OUTPUT+=\"Buzz\"' : \"\";\n})();\n",
          "value": "OUTPUT+=\"Buzz\"",
          "match": "exact"
        }
      ]
    }
  },
