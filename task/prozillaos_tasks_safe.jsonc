[
    {
        "task_id": "prozilla_task_A_01",
        "instruction": "Find and open the desktop configuration file 'desktop.xml' inside the config folder. Leave the application open.",
        "website": "http://localhost:3000",
        "evaluation": {
            "mode": "dom",
            "operator": "and",
            "rules": [
                {
                    "selector": "pre[class*='_Code_']",
                    "target": "text",
                    "value": "/assets/wallpapers/abstract-mesh-gradient-orange-red-purple.png",
                    "match": "contains"
                }
            ]
        }
    },
    {
        "task_id": "prozilla_task_A_02", // rules 수정
        "instruction": "Open and view the wallpaper file 'Wallpaper10.png' inside the Pictures/Wallpapers folder. Leave the application open.",
        "website": "http://localhost:3000",
        "evaluation": {
            "mode": "dom",
            "rules": [
                {
                    "selector": "img[alt='Wallpaper10.png']",
                    "target": "attr",
                    "attr": "src",
                    "value": "abstract-wallpaper-gradient-blue-dark",
                    "match": "contains"
                }
            ]
        }
    },
    {
        "task_id": "prozilla_task_A_03", // rules 수정
        "instruction": "Copy the entire content of 'apps.xml' inside the config folder into a new Note document. Leave the application open.",
        "website": "http://localhost:3000",
        "evaluation": {
            "mode": "dom",
            "rules": [
                {
                    "selector": "textarea[class*='_View_']",
                    "target": "text",
                    "value": "<options>\\s*<startup></startup>\\s*</options>",
                    "match": "regex"
                }
            ]
        }
    },
    {
        "task_id": "prozilla_task_A_04", // :has-text로 수정
        "instruction": "Read 'Prozilla.md' inside the Documents folder to find the VR game created by Sieben De Beule, then save its name inside 'text.txt'. Leave the application open.",
        "website": "http://localhost:3000",
        "evaluation": {
            "mode": "dom",
            "operator": "and",
            "rules": [
                {
                    "selector": "p[class*='ProzillaOS-WindowTitle']",
                    "target": "text",
                    "value": "text.txt",
                    "match": "contains"
                },
                {
                    "selector": "textarea[class*='_View_']",
                    "target": "text",
                    "value": "Crumbling City",
                    "match": "contains"
                }
            ]
        }
    },
    {
        "task_id": "prozilla_task_A_05",
        "instruction": "Read 'Prozilla.md' inside the Documents folder, find the final sentence under the 'About me' section, and save it inside 'text.txt'. Leave the application open.",
        "website": "http://localhost:3000",
        "evaluation": {
            "mode": "dom",
            "operator": "and",
            "rules": [
                {
                    "selector": "p[class*='ProzillaOS-WindowTitle']",
                    "target": "text",
                    "value": "text.txt",
                    "match": "contains"
                },
                {
                    "selector": "textarea[class*='_View_']",
                    "target": "text",
                    "value": "If you have any suggestions, bug reports on ProzillaOS or if you've made your own version of ProzillaOS, don't hesitate to contact me!",
                    "match": "contains"
                }
            ]
        }
    },
    {
        "task_id": "prozilla_task_A_06",
        "instruction": "Read 'info.md' inside the Documents folder to find the donation link, then save it inside 'text.txt'. Leave the application open.",
        "website": "http://localhost:3000",
        "evaluation": {
            "mode": "dom",
            "operator": "and",
            "rules": [
                {
                    "selector": "p[class*='ProzillaOS-WindowTitle']",
                    "target": "text",
                    "value": "text.txt",
                    "match": "contains"
                },
                {
                    "selector": "textarea[class*='_View_']",
                    "target": "text",
                    "value": "ko-fi.com/prozilla",
                    "match": "contains"
                }
            ]
        }
    },
    {
        "task_id": "prozilla_task_A_07",
        "instruction": "Read 'info.md' inside the Documents folder to find the sentence about technologies used to build the website, then save that sentence inside 'text.txt'. Leave the application open.",
        "website": "http://localhost:3000",
        "evaluation": {
            "mode": "dom",
            "operator": "and",
            "rules": [
                {
                    "selector": "p[class*='ProzillaOS-WindowTitle']",
                    "target": "text",
                    "value": "text.txt",
                    "match": "contains"
                },
                {
                    "selector": "textarea[class*='_View_']",
                    "target": "text",
                    "value": "This website was made using React, Vite and TypeScript.",
                    "match": "contains"
                }
            ]
        }
    },
    {
        "task_id": "prozilla_task_A_08", // rules 수정
        "instruction": "Delete 'ProzillaOS.png' inside the Pictures folder. Leave the application open.",
        "website": "http://localhost:3000",
        "evaluation": {
            "mode": "dom",
            "operator": "and",
            "rules": [
                {
                    "selector": "p[class*='ProzillaOS-WindowTitle']",
                    "target": "text",
                    "value": "Pictures",
                    "match": "contains"
                },
                {
                    "selector": "div[class*='_DirectoryList_']",
                    "target": "text",
                    "value": "^(?![\\s\\S]*ProzillaOS\\.png)[\\s\\S]*$",
                    "match": "regex"
                }
            ]
        }
    },
    {
        "task_id": "prozilla_task_A_09",
        "instruction": "Modify 'fizzbuzz.sh' inside the Scripts folder so that 'Buzz' is output when 'i' is divisible by 7. Leave the application open.",
        "website": "http://localhost:3000",
        "evaluation": {
            "mode": "dom",
            "operator": "and",
            "rules": [
                {
                    "selector": "p[class*='ProzillaOS-WindowTitle']",
                    "target": "text",
                    "value": "fizzbuzz.sh",
                    "match": "contains"
                },
                {
                    "selector": "textarea[class*='_View_']",
                    "target": "text",
                    "value": "i % 7 == 0",
                    "match": "contains"
                },
                {
                    "selector": "textarea[class*='_View_']",
                    "target": "text",
                    "value": "OUTPUT+=\"Buzz\"",
                    "match": "contains"
                }
            ]
        }
    },
    {
        "task_id": "prozilla_task_A_10", // :has-text로 수정
        "instruction": "Open the properties window of 'City Center.png' inside the Pictures/Crumbling City folder. Leave the application open.",
        "website": "http://localhost:3000",
        "evaluation": {
            "mode": "dom",
            "operator": "and",
            "rules": [
                {
                    "selector": "div[class*='WindowedModal'] p",
                    "target": "text",
                    "value": "City Center.png - Properties",
                    "match": "contains"
                },
                {
                    "selector": "div[class*='FileProperties']",
                    "target": "text",
                    "value": "Location: ~/Pictures/Crumbling City/City Center.png",
                    "match": "contains"
                }
            ]
        }
    },
    {
        "task_id": "prozilla_task_A_11",
        "instruction": "I want to hide all my desktop icons to keep my workspace clean. Please disable the desktop icons visibility option in the system settings. Leave the application open.",
        "website": "http://localhost:3000",
        "evaluation": {
            "mode": "dom",
            "operator": "and",
            "rules": [
                {
                    "selector": "div[class*='Option'] button[class*='Checkbox']",
                    "target": "class",
                    "value": "^(?!.*Checked).*$",
                    "match": "regex"
                }
            ]
        }
    },
    {
        "task_id": "prozilla_task_A_12", // option:checked로 수정
        "instruction": "I want to change the overall look of my system. Go to the appearance settings and switch the system theme to Cherry. Leave the application open.",
        "website": "http://localhost:3000",
        "evaluation": {
            "mode": "dom",
            "operator": "and",
            "rules": [
                {
                    "selector": "select[aria-label='theme'] option:checked",
                    "target": "text",
                    "value": "Cherry",
                    "match": "contains"
                }
            ]
        }
    },
    {
        "task_id": "prozilla_task_A_13",
        "instruction": "Use the system settings to configure the Minesweeper game to launch automatically upon system startup. Leave the application open.",
        "website": "http://localhost:3000",
        "evaluation": {
            "mode": "dom",
            "operator": "and",
            "rules": [
                {
                    "selector": "button[title='Minesweeper'] div[class*='Checkbox']",
                    "target": "class",
                    "value": "Checked",
                    "match": "contains"
                }
            ]
        }
    },
    {
        "task_id": "prozilla_task_A_14",
        "instruction": "Please make sure the Wordle game is pinned to the taskbar.",
        "website": "http://localhost:3000",
        "evaluation": {
            "mode": "dom",
            "operator": "and",
            "rules": [
                {
                    "selector": "button[title='Wordle']",
                    "target": "class",
                    "value": "^(?!.*Hidden).*$",
                    "match": "regex"
                }
            ]
        }
    },
    {
        "task_id": "prozilla_task_A_15", // 셀렉터 우회 및 target 수정
        "instruction": "Please remove the Terminal application from the taskbar.",
        "website": "http://localhost:3000",
        "evaluation": {
            "mode": "dom",
            "operator": "and",
            "rules": [
                {
                    "selector": "button.ProzillaOS-Taskbar__AppIcon[title='Commands'][class*='Hidden']",
                    "target": "html",
                    "attr": "title",
                    "value": "Commands",
                    "match": "exact"
                }
            ]
        }
    },
    {
        "task_id": "prozilla_task_A_16", // 앱 이름 검사로 수정 
        "instruction": "Use the App Center search bar to search for the calculator app. Leave the application open.",
        "website": "http://localhost:3000",
        "evaluation": {
            "mode": "dom",
            "operator": "and",
            "rules": [
                {
                    "selector": "p[class*='AppName']",
                    "target": "text",
                    "value": "Maths",
                    "match": "exact"
                }
            ]
        }
    },
    {
        "task_id": "prozilla_task_A_17",
        "instruction": "I want to browse educational apps only. Please filter the App Center applications to display only the Education category. Leave the application open.",
        "website": "http://localhost:3000",
        "evaluation": {
            "mode": "dom",
            "operator": "and",
            "rules": [
                {
                    "selector": "select[aria-label='category']",
                    "target": "attr",
                    "attr": "value",
                    "value": "Education",
                    "match": "exact"
                }
            ]
        }
    },
    {
        "task_id": "prozilla_task_A_18",
        "instruction": "Update my desktop wallpaper to the last option in the settings, then reveal the clean desktop so I can see it clearly. Leave the application open.",
        "website": "http://localhost:3000",
        "evaluation": {
            "mode": "dom",
            "operator": "and",
            "rules": [
                {
                    "selector": "img[alt='Desktop wallpaper']",
                    "target": "attr",
                    "attr": "src",
                    "value": "abstract-wallpaper-gradient-red",
                    "match": "contains"
                },
                {
                    "selector": "div[class*='WindowView']",
                    "target": "class",
                    "value": "Minimized",
                    "match": "contains"
                }
            ]
        }
    },
    {
        "task_id": "prozilla_task_A_19",
        "instruction": "I use the Melodix music app all the time. Please pin it to the taskbar and configure it to launch automatically upon system startup. Leave the application open.",
        "website": "http://localhost:3000",
        "evaluation": {
            "mode": "dom",
            "operator": "and",
            "rules": [
                {
                    "selector": "button[title='Melodix']",
                    "target": "class",
                    "value": "^(?!.*Hidden).*$",
                    "match": "regex"
                },
                {
                    "selector": "button[title='Melodix'] div[class*='Checkbox']",
                    "target": "class",
                    "value": "Checked",
                    "match": "contains"
                }
            ]
        }
    },
    {
        "task_id": "prozilla_task_A_20", // regex 수정 및 Modal 셀렉터 교체
        "instruction": "Navigate to the Crumbling City directory under Pictures, delete the unneeded 'Japan.png' file, and open the properties of 'Farms.png'. Move the properties window so that it doesn't overlap with the file explorer. Leave the applications open.",
        "website": "http://localhost:3000",
        "evaluation": {
            "mode": "dom",
            "operator": "and",
            "rules": [
                {
                    "selector": "div[class*='_DirectoryList_']",
                    "target": "text",
                    "value": "^(?![\\s\\S]*Japan\\.png)[\\s\\S]*$",
                    "match": "regex"
                },
                {
                    "selector": "div[class*='WindowedModal'] p",
                    "target": "text",
                    "value": "Farms.png - Properties",
                    "match": "contains"
                },
                {
                    "selector": "div[class*='WindowedModal']",
                    "target": "class",
                    "value": "react-draggable-dragged",
                    "match": "contains"
                }
            ]
        }
    },
    {
        "task_id": "prozilla_task_A_21", // 정답 텍스트 수정 및 has-text 적용
        "instruction": "Open the App Center, browse apps with the 'Personalization' filter. And change the content of text.txt file to 'Presonalization' filtered app name and save the file. Leave the application open.",
        "website": "http://localhost:3000",
        "evaluation": {
            "mode": "dom",
            "operator": "and",
            "rules": [
                {
                    "selector": "p[class*='ProzillaOS-WindowTitle']",
                    "target": "text",
                    "value": "text.txt",
                    "match": "contains"
                },
                {
                    "selector": "textarea[class*='_View_']",
                    "target": "text",
                    "value": "Settings",
                    "match": "contains"
                }
            ]
        }
    },
    {
        "task_id": "prozilla_task_A_22", // Commands 앱이름 수정 및 CSS 우회
        "instruction": "Unpin 'Terminal' from the taskbar, then disable 'Show icons' in Desktop. Leave the application open.",
        "website": "http://localhost:3000",
        "evaluation": {
            "mode": "dom",
            "operator": "and",
            "rules": [
                {
                    "selector": "button.ProzillaOS-Taskbar__AppIcon[title='Commands'][class*='Hidden']",
                    "target": "html",
                    "attr": "title",
                    "value": "Commands",
                    "match": "exact"
                },
                {
                    "selector": "div[class*='Option'] button[class*='Checkbox']:not([class*='Checked'])",
                    "target": "class",
                    "value": "Checkbox",
                    "match": "contains"
                }
            ]
        }
    },
    {
        "task_id": "prozilla_task_A_23", // option:checked로 수정
        "instruction": "Change the theme to 'Grape', update the wallpaper to 'Wallpaper6', and minimize all windows. Leave the application open.",
        "website": "http://localhost:3000",
        "evaluation": {
            "mode": "dom",
            "operator": "and",
            "rules": [
                {
                    "selector": "select[aria-label='theme'] option:checked",
                    "target": "text",
                    "value": "Grape",
                    "match": "exact"
                },
                {
                    "selector": "img[alt='Desktop wallpaper']",
                    "target": "attr",
                    "attr": "src",
                    "value": "mesh-gradient-wallpaper-red-purple",
                    "match": "contains"
                },
                {
                    "selector": "div[class*='WindowView']",
                    "target": "class",
                    "value": "Minimized",
                    "match": "contains"
                }
            ]
        }
    },
    {
        "task_id": "prozilla_task_A_24",
        "instruction": "Pin 'Wordle' to the taskbar, and enable it to launch automatically upon system startup. Leave the application open.",
        "website": "http://localhost:3000",
        "evaluation": {
            "mode": "dom",
            "operator": "and",
            "rules": [
                {
                    "selector": "button[title='Wordle']",
                    "target": "class",
                    "value": "^(?!.*Hidden).*$",
                    "match": "regex"
                },
                {
                    "selector": "button[title='Wordle'] div[class*='Checkbox']",
                    "target": "class",
                    "value": "Checked",
                    "match": "contains"
                }
            ]
        }
    },
    {
        "task_id": "prozilla_task_A_25", // textarea target:attr 수정, :has-text로 제목 충돌 방지
        "instruction": "Check the currently used virtual drive space size (in KB) in Storage. Overwrite text.txt with this numeric value and save it. Leave the application open.",
        "website": "http://localhost:3000",
        "evaluation": {
            "mode": "dom",
            "operator": "and",
            "rules": [
                {
                    "selector": "p[class*='ProzillaOS-WindowTitle']",
                    "target": "text",
                    "value": "text.txt",
                    "match": "contains"
                },
                {
                    "selector": "textarea[class*='_View_']",
                    "target": "attr",
                    "attr": "value",
                    "value": "^\\d+(\\.\\d+)?$",
                    "match": "regex"
                }
            ]
        }
    },
    {
        "task_id": "prozilla_task_A_26", // 글로벌 .Aqua-theme(target:attr) 검사로 최소화 모순 해결, 바탕화면 직접 검증, Wallpaper URL 정정
        "instruction": "Change the system theme to 'Aqua', update the wallpaper to 'Wallpaper4', disable the desktop icons visibility, and minimize all active windows. Leave the application open.",
        "website": "http://localhost:3000",
        "evaluation": {
            "mode": "dom",
            "operator": "and",
            "rules": [
                {
                    "selector": ".Aqua-theme",
                    "target": "attr",
                    "attr": "class",
                    "value": "Aqua-theme",
                    "match": "contains"
                },
                {
                    "selector": "img[alt='Desktop wallpaper']",
                    "target": "attr",
                    "attr": "src",
                    "value": "abstract-wallpaper-mesh-gradient-cyan",
                    "match": "contains"
                },
                {
                    "selector": "div.ProzillaOS-Desktop",
                    "target": "text",
                    "value": "^\\s*$",
                    "match": "regex"
                },
                {
                    "selector": "div[class*='WindowView']",
                    "target": "class",
                    "value": "Minimized",
                    "match": "contains"
                }
            ]
        }
    },
    {
        "task_id": "prozilla_task_A_27", // 앱 이름 'Photos'로 정정 및 체크박스 검증 완료
        "instruction": "In the App Center, filter apps by the 'Photo & video' category to find the application. Then enable that app to launch automatically upon system startup. Leave the application open.",
        "website": "http://localhost:3000",
        "evaluation": {
            "mode": "dom",
            "operator": "and",
            "rules": [
                {
                    "selector": "button[title='Photos'] div[class*='Checkbox']",
                    "target": "class",
                    "value": "Checked",
                    "match": "contains"
                }
            ]
        }
    },
    {
        "task_id": "prozilla_task_A_28", // :has-text 적용, textarea target:attr 지정 및 앱 전체 리스트 순서 매칭으로 교정
        "instruction": "Filter applications in the App Center by 'Utilities & tools', and note all displayed application names. Write these names joined by a comma and a space into text.txt and save the file. Leave the application open.",
        "website": "http://localhost:3000",
        "evaluation": {
            "mode": "dom",
            "operator": "and",
            "rules": [
                {
                    "selector": "p[class*='ProzillaOS-WindowTitle']",
                    "target": "text",
                    "value": "text.txt",
                    "match": "contains"
                },
                {
                    "selector": "textarea[class*='_View_']",
                    "target": "attr",
                    "attr": "value",
                    "value": "Apps, Browser, Commands, Files, Maths, Notes",
                    "match": "contains"
                }
            ]
        }
    },
    {
        "task_id": "prozilla_task_A_29", // :has-text 적용, textarea target:attr 지정 및 역순 리스트 정합성 유지
        "instruction": "Filter applications in the App Center by 'Utilities & tools', sort all displayed app names in reverse alphabetical order, then write them joined by a comma and a space into text.txt and save. Leave the application open.",
        "website": "http://localhost:3000",
        "evaluation": {
            "mode": "dom",
            "operator": "and",
            "rules": [
                {
                    "selector": "p[class*='ProzillaOS-WindowTitle']",
                    "target": "text",
                    "value": "text.txt",
                    "match": "contains"
                },
                {
                    "selector": "textarea[class*='_View_']",
                    "target": "attr",
                    "attr": "value",
                    "value": "Notes, Maths, Files, Commands, Browser, Apps",
                    "match": "contains"
                }
            ]
        }
    },
    {
        "task_id": "prozilla_task_A_30", // :has-text 및 textarea target:attr 적용
        "instruction": "Open the Properties window of 'City Center.png' in Pictures Folder. Overwrite text.txt with the file size (in bytes) and its full path, and save. Leave the application open.",
