        }
    },
    {
        "task_id": "prozilla_task_A_34", // :has-text 충돌 방지 및 textarea target:attr
        "instruction": "In the App Center, filter applications by 'Personalization' and 'Education' categories separately, and count the number of apps displayed in each category. Write a report inside 'text.txt' in the format 'Personalization: [count], Education: [count]' and save the file. Leave the application open.",
        "website": "http://localhost:3000",
        "evaluation": {
            "mode": "dom",
            "operator": "and",
            "rules": [
                {
                    "selector": "p[class*='ProzillaOS-WindowTitle']",
                    "target": "text",
                    "value": "text.txt",
                    "match": "contains"
                },
                {
                    "selector": "textarea[class*='_View_']",
                    "target": "attr",
                    "attr": "value",
                    "value": "Personalization:\\s*1,\\s*Education:\\s*1",
                    "match": "regex"
                }
            ]
        }
    },
    {
        "task_id": "prozilla_task_A_35", // :has-text 충돌 방지 및 textarea target:attr 세트 장착 완료
        "instruction": "Read the developer's name, email, and portfolio address from 'prozilla.md' inside the Documents folder. Change the content of 'text.txt' to organize this information in the format 'Name: [name], Email: [email], Portfolio: [portfolio]' and save the file. Leave the application open.",
