    {
        "task_id": "prozilla_task_A_32", // :has-text 표준 셀렉터 및 textarea target:attr
        "instruction": "Read the developer's business email from 'prozilla.md' and the donation link from 'info.md' inside the Documents folder. Change the content of 'text.txt' to 'email: [email], donate: [donation_link]' format and save the file. Leave the application open.",
        "website": "http://localhost:3000",
        "evaluation": {
            "mode": "dom",
            "operator": "and",
            "rules": [
                {
                    "selector": "p[class*='ProzillaOS-WindowTitle']",
                    "target": "text",
                    "value": "text.txt",
                    "match": "contains"
                },
                {
                    "selector": "textarea[class*='_View_']",
                    "target": "attr",
                    "attr": "value",
                    "value": "email: business@prozilla.dev, donate: Ko-fi page",
                    "match": "contains"
                }
            ]
        }
    },
    {
        "task_id": "prozilla_task_A_33", // 모호한 부정 정규식을 텅 빈 폴더(Empty) 검사 정규식으로 안정화
        "instruction": "Delete all images inside 'Pictures/Crumbling City'. Leave the application open.",
