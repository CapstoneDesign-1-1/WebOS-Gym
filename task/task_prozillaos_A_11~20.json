  {
    "task_id": "prozilla_task_A_20",
    "instruction": "Navigate to the Crumbling City directory under Pictures, delete the unneeded 'Japan.png' file, and open the properties of 'Farms.png'. Move the properties window so that it doesn't overlap with the file explorer.",
    "website": "http://localhost:3000",
    "evaluation": {
      "mode": "dom",
      "operator": "and",
      "rules": [
        {
          "selector": "div[class*='_DirectoryList_']",
          "target": "text",
          "value": "^(?!.*Japan\\.png).*$",
          "match": "regex"
        },
        {
          "selector": "p:has-text('Farms.png - Properties')",
          "target": "text",
          "value": "Farms.png - Properties",
          "match": "contains"
        },
        {
          "selector": "div:has(p:has-text('Farms.png - Properties'))",
          "target": "class",
          "value": "react-draggable-dragged",
          "match": "contains"
        }
      ]
    }
  }
