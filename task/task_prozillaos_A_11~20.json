[
  {
    "task_id": "prozilla_task_A_11",
    "instruction": "I want to hide all my desktop icons to keep my workspace clean. Please disable the desktop icons visibility option in the system settings.",
    "website": "http://localhost:3000",
    "evaluation": {
      "mode": "dom",
      "operator": "and",
      "rules": [
        {
          "selector": "div:has(p:has-text('Show icons')) button[class*='Checkbox']",
          "target": "class",
          "value": "^(?!.*Checked).*$",
          "match": "regex"
        }
      ]
    }
  },
  {
    "task_id": "prozilla_task_A_12",
