[
  {
    "task_id": "fp_finance_01",
    "instruction": "Calculate overtime pay on the DOL website for 45 hours at $20/hr (Standard result: $950). Input this into Spreadsheet cell A1. Multiply by exchange rate 1400 in cell B1 to get 1330000. Finally, open Prozilla OS Notes app and save the text '1330000'. Leave the applications open.",
    "website": [
      {
        "id": "web",
        "url": "https://webapps.dol.gov/elaws/otcalculator.htm"
      },
      {
        "id": "sheet",
        "url": "http://localhost:3000/spreadsheet"
      },
      {
        "id": "os",
        "url": "http://localhost:3000"
      }
    ],
    "evaluation": {
      "mode": "dom",
      "operator": "and",
      "rules": [
        {
          "website_id": "sheet",
          "selector": "div[data-cell='B1']",
          "target": "text",
          "value": "1330000",
          "match": "contains"
        },
        {
          "website_id": "os",
          "selector": "textarea[class*='_View_']",
          "target": "text",
          "value": "1330000",
          "match": "contains"
        }
      ]
    }
  },
